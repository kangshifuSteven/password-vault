[Unit]
Description=Password Vault encrypted sync service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.local/lib/password-vault/server.mjs
Environment=PASSWORD_VAULT_HOST=127.0.0.1
Environment=PASSWORD_VAULT_PORT=39871
Environment=PASSWORD_VAULT_APP_DIR=%h/.local/lib/password-vault
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
